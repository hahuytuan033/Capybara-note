<Window x:Class="CapNote.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CapNote.App.Controls" xmlns:local="clr-namespace:CapNote.App"
 Title="CapNote" Width="500" Height="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{StaticResource DeskBrush}"
 Icon="Assets/favicon.ico" PreviewKeyDown="WindowKeyDown">
 <Window.Resources>
  <local:HexBrushConverter x:Key="BrushConverter"/>
  <local:NullToVisibilityConverter x:Key="NullVisibility"/>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  <Style x:Key="AddNoteButtonStyle" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid x:Name="GlowHost" Background="Transparent" RenderTransformOrigin="0.5,0.5">
       <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="GlowHost" Property="Effect">
         <Setter.Value><DropShadowEffect Color="#3B82F6" BlurRadius="9" ShadowDepth="0" Opacity="1" RenderingBias="Quality"/></Setter.Value>
        </Setter>
        <Setter TargetName="GlowHost" Property="RenderTransform">
         <Setter.Value><ScaleTransform ScaleX="1.06" ScaleY="1.06"/></Setter.Value>
        </Setter>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="GlowHost" Property="RenderTransform">
         <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
        </Setter>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="GlowHost" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Background="{StaticResource DeskBrush}">
  <Canvas x:Name="Board" Width="475" Height="450" VerticalAlignment="Top" Margin="0,3,0,0" Background="{StaticResource BoardBrush}" ClipToBounds="True" MouseLeftButtonDown="BoardMouseDown">
   <Canvas.Clip><RectangleGeometry Rect="0,0,475,450" RadiusX="38" RadiusY="38"/></Canvas.Clip>
   <ItemsControl ItemsSource="{Binding Notes}" Width="475" Height="450">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter">
     <Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/>
    </Style></ItemsControl.ItemContainerStyle>
    <ItemsControl.ItemTemplate><DataTemplate>
     <controls:StickyNoteControl Width="{Binding Width}" Height="{Binding Height}" IsSelected="{Binding IsSelected}" RenderTransformOrigin=".5,.5"
       OpenRequested="OpenNote" DeleteRequested="DeleteNote" SelectionRequested="SelectNote" InteractionStarted="NoteInteractionStarted" InteractionCompleted="NoteInteractionCompleted">
      <controls:StickyNoteControl.RenderTransform><RotateTransform Angle="{Binding Rotation}"/></controls:StickyNoteControl.RenderTransform>
     </controls:StickyNoteControl>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <StackPanel Canvas.Left="80" Canvas.Top="165" Width="315" IsHitTestVisible="False"
               Visibility="{Binding HasNoNotes, Converter={StaticResource BooleanToVisibilityConverter}}">
    <TextBlock Text="Board đang trống" Foreground="#F7E9D8" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
    <TextBlock Text="Bấm tờ giấy phía dưới để tạo note đầu tiên  ↘" Foreground="#F7E9D8" FontSize="15" TextAlignment="Center" Margin="0,8,0,0"/>
   </StackPanel>
  </Canvas>

  <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,18,0" Width="38" Height="38" Panel.ZIndex="10"
          Content="?" FontSize="18" FontWeight="Bold" Command="{Binding ShowOnboardingCommand}" ToolTip="Xem hướng dẫn sử dụng"/>

  <Grid VerticalAlignment="Bottom" Height="350">
   <controls:CapybaraAnimation x:Name="Capybara" Width="340" Height="340" HorizontalAlignment="Center" Margin="70,0,0,-35" IsHitTestVisible="False"/>
   <Button IsHitTestVisible="True" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,38,52"
           Command="{Binding AddNoteCommand}" Style="{StaticResource AddNoteButtonStyle}" ToolTip="Thêm note (Ctrl+N)">
    <Image Source="pack://siteoforigin:,,,/Assets/note_btn.png" Stretch="Uniform"/>
   </Button>
  </Grid>

  <Border Background="#66000000" Visibility="{Binding ActiveNote, Converter={StaticResource NullVisibility}}" Panel.ZIndex="20">
   <Border Width="360" MaxHeight="700" Background="{StaticResource BoardBrush}" BorderBrush="{StaticResource BoardBorderBrush}" BorderThickness="4" CornerRadius="36" Padding="20">
    <Grid DataContext="{Binding ActiveNote}">
     <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{Binding Color, Converter={StaticResource BrushConverter}}" CornerRadius="24" Padding="20" MinHeight="390">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
       <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="25" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Background="Transparent" BorderThickness="0" TextWrapping="Wrap"/>
       <ListBox x:Name="Checklist" Grid.Row="1" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" AllowDrop="True"
                PreviewMouseLeftButtonDown="ChecklistMouseDown" PreviewMouseMove="ChecklistMouseMove" Drop="ChecklistDrop">
        <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,3">
         <Button DockPanel.Dock="Right" Content="×" Width="22" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
         <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Top" Margin="0,5,8,0"/>
         <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Foreground="{StaticResource InkBrush}" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True"/>
        </DockPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
     </Border>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,8">
      <Button Content="＋ việc" Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="10,6" Margin="0,0,6,0"/>
      <Button Content="⌂" Command="{Binding DataContext.SetIconCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Home" Width="38"/>
      <Button Content="▣" Command="{Binding DataContext.SetIconCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Work" Width="38"/>
      <Button Content="▤" Command="{Binding DataContext.SetIconCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Book" Width="38"/>
      <Button Content="♧" Command="{Binding DataContext.SetIconCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Leaf" Width="38"/>
      <Button Content="∅" Command="{Binding DataContext.SetIconCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="None" Width="38"/>
      <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Width="72" Margin="6,0,0,0" VerticalContentAlignment="Center" ToolTip="Màu HEX, ví dụ #F1C40F"/>
     </StackPanel>
     <DockPanel Grid.Row="2">
      <Button DockPanel.Dock="Right" Content="Xong" Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="14,7"/>
      <Button Content="Xóa note" Foreground="IndianRed" Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,7"/>
      <ItemsControl ItemsSource="{Binding DataContext.PresetColors, RelativeSource={RelativeSource AncestorType=Window}}" Margin="8,0">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><Button Width="25" Height="25" Margin="2" Background="{Binding Converter={StaticResource BrushConverter}}"
         Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </DockPanel>
    </Grid>
   </Border>
  </Border>

  <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12" Padding="14,9" CornerRadius="12" Background="#EECCFFCC" Panel.ZIndex="50"
          Visibility="{Binding ToastMessage, Converter={StaticResource NullVisibility}}">
   <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
    <Button Content="Hoàn tác" Margin="10,0,0,0" Command="{Binding UndoDeleteCommand}" Visibility="{Binding CanUndo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
   </StackPanel>
  </Border>

  <Border Panel.ZIndex="60" Background="#99000000" Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
   <Border Width="370" Padding="26" CornerRadius="28" Background="#FDF2D5" BorderBrush="#A06E45" BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel>
     <TextBlock Text="Hướng dẫn nhanh" Foreground="#A06E45" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
     <TextBlock Text="{Binding OnboardingTitle}" Foreground="{StaticResource InkBrush}" FontSize="26" FontWeight="Bold" TextAlignment="Center" Margin="0,10,0,8"/>
     <TextBlock Text="{Binding OnboardingMessage}" Foreground="{StaticResource InkBrush}" FontSize="17" TextWrapping="Wrap" TextAlignment="Center" MinHeight="70"/>
     <TextBlock Text="{Binding OnboardingProgress}" Foreground="#A06E45" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,18"/>
     <DockPanel>
      <Button Content="Bỏ qua" Command="{Binding SkipOnboardingCommand}" Padding="14,8" Background="Transparent"/>
      <Button Content="Tiếp / Đã hiểu" Command="{Binding NextOnboardingCommand}" Padding="18,8" HorizontalAlignment="Right" Background="#3B82F6" Foreground="White"/>
     </DockPanel>
    </StackPanel>
   </Border>
  </Border>
 </Grid>
</Window>

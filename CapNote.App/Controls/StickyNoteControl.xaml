<UserControl x:Class="CapNote.App.Controls.StickyNoteControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:CapNote.App" x:Name="ControlRoot" Focusable="True">
  <UserControl.Resources>
    <local:HexBrushConverter x:Key="BrushConverter"/>
    <Style x:Key="RevealWhenActive" TargetType="FrameworkElement">
      <Setter Property="Opacity" Value="0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ControlRoot}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
        <DataTrigger Binding="{Binding IsSelected, ElementName=ControlRoot}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Border x:Name="NoteBorder" Background="{Binding Color, Converter={StaticResource BrushConverter}}" Padding="10" CornerRadius="3">
    <Border.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="2" Opacity="0.22"/></Border.Effect>
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="#22000000"/><Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsMouseOver, ElementName=ControlRoot}" Value="True">
            <Setter Property="BorderBrush" Value="#883B82F6"/><Setter Property="BorderThickness" Value="2"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsSelected, ElementName=ControlRoot}" Value="True">
            <Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="BorderThickness" Value="3"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions>

      <Border x:Name="DragHeader" Grid.Row="0" Margin="-6,-6,-6,2" Padding="6,4" Background="#0D000000" CornerRadius="3,3,0,0"
              Cursor="SizeAll" MouseLeftButtonDown="HeaderMouseDown" ToolTip="Giữ và kéo để di chuyển note">
        <DockPanel>
          <Button DockPanel.Dock="Right" Width="32" Height="32" Margin="4,-2,-2,-2" Padding="0" Content="×" FontSize="20"
                  Click="DeleteNote" ToolTip="Xóa note" Style="{StaticResource RevealWhenActive}"/>
          <TextBlock DockPanel.Dock="Left" Text="⠿" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center"
                     Foreground="{Binding InkColor, Converter={StaticResource BrushConverter}}" ToolTip="Kéo để di chuyển"/>
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" FontFamily="{StaticResource MomoFont}"
                     Foreground="{Binding InkColor, Converter={StaticResource BrushConverter}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OpenNote" ToolTip="Bấm để mở và chỉnh sửa">
        <ItemsControl ItemsSource="{Binding Items}" ClipToBounds="True">
          <ItemsControl.ItemTemplate><DataTemplate>
            <DockPanel Margin="0,2">
              <Border Width="14" Height="14" Margin="0,1,6,0" BorderBrush="{Binding DataContext.InkColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BrushConverter}}" BorderThickness="1.5" CornerRadius="2">
                <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Background" Value="#553B4D9B"/></DataTrigger></Style.Triggers></Style></Border.Style>
              </Border>
              <TextBlock Text="{Binding Text}" FontSize="13" Foreground="{Binding DataContext.InkColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BrushConverter}}" TextWrapping="Wrap"/>
            </DockPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Thumb Grid.RowSpan="2" HorizontalAlignment="Right" Width="12" Cursor="SizeWE" DragStarted="ResizeStarted" DragDelta="ResizeEast" DragCompleted="ResizeCompleted" Style="{StaticResource RevealWhenActive}"/>
      <Thumb Grid.Row="1" VerticalAlignment="Bottom" Height="12" Cursor="SizeNS" DragStarted="ResizeStarted" DragDelta="ResizeSouth" DragCompleted="ResizeCompleted" Style="{StaticResource RevealWhenActive}"/>
      <Thumb Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="28" Height="28" Cursor="SizeNWSE"
             DragStarted="ResizeStarted" DragDelta="ResizeCorner" DragCompleted="ResizeCompleted" Style="{StaticResource RevealWhenActive}" ToolTip="Kéo để đổi kích thước">
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><TextBlock Text="◢" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{Binding DataContext.InkColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BrushConverter}}"/></Grid></ControlTemplate></Thumb.Template>
      </Thumb>
    </Grid>
  </Border>
</UserControl>

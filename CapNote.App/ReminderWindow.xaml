<Window x:Class="CapNote.App.ReminderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="300" Height="200" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">
 <Grid Background="Transparent" MouseLeftButtonUp="OpenClicked">
  <Border Width="270" VerticalAlignment="Bottom" Margin="8" Padding="16" CornerRadius="24" Background="#FAFDF2D5" BorderBrush="#A06E45" BorderThickness="2">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel><Button DockPanel.Dock="Right" Content="×" Width="24" Height="24" Click="DismissClicked"/>
     <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MomoFont}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
    </DockPanel>
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}" Margin="0,8,0,0">
     <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><Border Width="8" Height="8" BorderBrush="#883B4D9B" BorderThickness="1" Margin="0,4,6,0"/><TextBlock Text="{Binding Text}" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </Grid>
  </Border>
 </Grid>
</Window>
